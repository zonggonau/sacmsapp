# =============================================================
# SaCMS — salin menjadi .env.local lalu isi nilainya.
# JANGAN pernah commit berkas berisi nilai asli.
# Referensi: docs/14-DEPLOYMENT-GO-LIVE.md §14.3
# =============================================================

# --- Inti ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon) ---
# Pooled connection — dipakai aplikasi
DATABASE_URL=
# Direct connection — dipakai prisma migrate
DIRECT_URL=

# --- Auth ---
# Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (v0 Platform API) ---
V0_API_KEY=
# Id valid: v0-mini, v0-auto, v0-pro, v0-max, v0-max-fast
V0_DEFAULT_MODEL=v0-mini
# true = pakai implementasi tiruan, tidak memanggil v0 dan tidak memakai kredit
V0_MOCK=true

# --- Deployment (Vercel) ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Wajib diisi agar webhook diterima. Kosong = SEMUA webhook ditolak (gagal tertutup).
VERCEL_WEBHOOK_SECRET=
# Mengikuti V0_MOCK (ADR-008): tiruan bila V0_MOCK=true, nyata bila V0_MOCK=false.
# Nilai true diabaikan saat V0_MOCK=false, karena v0 nyata menerbitkan ke Vercel sungguhan.
VERCEL_MOCK=true

# --- Infrastruktur ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
# PENTING: nama variabelnya EMAIL_FROM (bukan RESEND_FROM).
# Domain pengirim harus SUDAH diverifikasi di https://resend.com/domains,
# kalau tidak Resend menolak dengan 403 dan email verifikasi tidak pernah sampai.
# Untuk development sebelum domain diverifikasi, pakai pengirim bawaan Resend:
#   EMAIL_FROM="SaCMS <onboarding@resend.dev>"
EMAIL_FROM="SaCMS <noreply@sacms.id>"
# HANYA untuk uji E2E. Bila diisi, email ditulis sebagai berkas JSON ke folder
# ini dan TIDAK dikirim lewat Resend. Jangan pernah diisi di Vercel.
MAIL_OUTBOX_DIR=

# --- Operasional ---
# Memproteksi seluruh endpoint /api/cron — minimal 32 karakter
CRON_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Kanal dukungan (docs/14 §14.9) — tampil di footer & halaman Paket bila diisi.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Angka saja dengan kode negara, mis. 6281234567890
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# --- Seed (hanya untuk inisialisasi awal, hapus setelah dipakai) ---
SEED_SUPERADMIN_EMAIL=
# Minimal 16 karakter. Seed menolak berjalan di production bila kurang.
SEED_SUPERADMIN_PASSWORD=
