# =============================================================
# SaCMS — salin menjadi .env.local lalu isi nilainya.
# JANGAN pernah commit berkas berisi nilai asli.
# Referensi: docs/14-DEPLOYMENT-GO-LIVE.md §14.3
# =============================================================

# --- Inti ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon) ---
# Pooled connection — dipakai aplikasi
DATABASE_URL=
# Direct connection — dipakai prisma migrate
DIRECT_URL=

# --- Auth ---
# Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (v0 Platform API) ---
V0_API_KEY=
V0_DEFAULT_MODEL=v0-1.5-sm
# true = pakai implementasi tiruan, tidak memanggil v0 dan tidak memakai kredit
V0_MOCK=true

# --- Deployment (Vercel) ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Infrastruktur ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
EMAIL_FROM="SaCMS <noreply@sacms.id>"

# --- Operasional ---
# Memproteksi seluruh endpoint /api/cron — minimal 32 karakter
CRON_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Seed (hanya untuk inisialisasi awal, hapus setelah dipakai) ---
SEED_SUPERADMIN_EMAIL=
# Minimal 16 karakter. Seed menolak berjalan di production bila kurang.
SEED_SUPERADMIN_PASSWORD=
